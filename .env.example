# =============================================================================
# vectorDatabase 配置模板 —— 复制为 .env 后填写。
# 切勿把真实 .env（含密码/API Key）提交进 git（.gitignore 已忽略 /.env）。
# 字段含义与默认值见 app/config.py:Settings 与 docs/05-configuration.md。
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库 PostgreSQL —— 本服务用独立数据库 vector_kb（先 createdb vector_kb）
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=            # ← 强密码，绝不写进 git
DB_NAME=vector_kb

# -----------------------------------------------------------------------------
# Embedding（OpenAI 兼容 /v1/embeddings）—— 默认本地，不依赖云
# 默认本地 bge-m3：标准 OpenAI 兼容 /v1/embeddings 接口、**本地服务无需 API Key**、免费。
# 默认模型 bge-m3，默认维度 1024（EMBEDDING_DIM 必须与模型实际输出维度一致）。
# 生产把 host 换成实际本地地址；切换 embedding 模型会改变向量空间——已建库需重建（见 docs/20）。
# -----------------------------------------------------------------------------
EMBEDDING_BASE_URL=http://<bge-m3-host>:8111/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024     # bge-m3 输出 1024 维
EMBEDDING_API_KEY=     # 本地 bge-m3 留空；仅远程服务（下方 DashScope 备用）才需要

# 备用（非默认）：阿里云 DashScope compatible-mode（需 sk- Key、按量计费、单批 input 上限 10）
# 注意：账户欠费会同时阻断 embedding 与 rerank（整条检索链路瘫），请确保余额。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_API_KEY=<your-dashscope-key>

# -----------------------------------------------------------------------------
# Rerank（可选，默认关闭）—— 召回后重排提升精度
# 默认本地 Rerank：标准 /rerank 格式（Infinity/TEI/Jina/Cohere 等兼容服务通用），**本地服务无需 API Key**。
# 默认模型 bge-reranker-v2-m3。部署好本地 reranker 后填 RERANK_BASE_URL，再把 RERANK_ENABLED=true。
# -----------------------------------------------------------------------------
RERANK_PROVIDER=standard
RERANK_ENABLED=false
RERANK_BASE_URL=          # 本地示例：http://<reranker-host>:9000/rerank
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=          # 本地服务留空；仅远程（下方 DashScope 备用）才需要
RERANK_CANDIDATE_K=50

# 备用（非默认）：阿里云 DashScope text-rerank（需 sk- Key、按量计费；欠费会瘫检索链路）
# RERANK_PROVIDER=dashscope
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_MODEL=gte-rerank
# RERANK_API_KEY=<your-dashscope-key>

# -----------------------------------------------------------------------------
# Query Rewrite（多 query dense 召回；第一版，不接 LLM/Agent/Hybrid）
# 开启后：对 query 做规范化 + 同义词/简称扩展，分别 embedding 召回后按 chunk_id 合并去重。
# 关闭（默认）时 dense 召回逻辑完全不变。词典从 example 复制改名后按业务维护。
# -----------------------------------------------------------------------------
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_MAX_QUERIES=4
QUERY_REWRITE_SYNONYMS_PATH=config/query_synonyms.json

# 可选：LLM Query Rewrite（OpenAI 兼容 chat 接口；只生成检索 query，不回答、不接 Agent/工具）。
# 开启后与规则 rewrite 合并；LLM 失败/超时/非法 JSON 自动退回规则 rewrite，不阻断检索。
QUERY_REWRITE_LLM_ENABLED=false
QUERY_REWRITE_LLM_BASE_URL=          # 如 http://<llm-host>:8000/v1
QUERY_REWRITE_LLM_MODEL=             # 如 qwen2.5-7b-instruct
QUERY_REWRITE_LLM_API_KEY=           # 本地服务可留空
QUERY_REWRITE_LLM_TIMEOUT_SECONDS=8
QUERY_REWRITE_LLM_MAX_QUERIES=4

# -----------------------------------------------------------------------------
# Chat 用户端（轻量问答 v1；默认关）
# 普通用户在站内对有 read 权限的库直接问答；复用现有检索 + OpenAI 兼容 chat 模型生成答案。
# 只生成答案、不接 Agent/工具；会话与消息落库（支持多轮追问，管理端 chat_logs 可查）。关闭时 /chat/messages 返回 503。
# CHAT_BASE_URL 支持 http://host:8000/v1 或完整 .../chat/completions；本地模型可不填 KEY。
# -----------------------------------------------------------------------------
CHAT_ENABLED=false
CHAT_BASE_URL=          # 如 http://<llm-host>:8000/v1
CHAT_MODEL=             # 如 qwen2.5-7b-instruct
CHAT_API_KEY=           # 本地模型可留空
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_TEMPERATURE=0.2
CHAT_HISTORY_MAX_TURNS=5          # 多轮追问带入最近几轮历史（0=不带）

# -----------------------------------------------------------------------------
# Qdrant 向量库
# 公网暴露的 Qdrant 务必设 QDRANT_API_KEY；内网部署也建议设。
# -----------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 全文源数据库（可选）—— 外部「正文库」所在 PostgreSQL，检索按外键回查正文。
# 任意项留空 = 回退上面主库 DB_* 同名值。不接外部正文库可整段留空。
# -----------------------------------------------------------------------------
SOURCE_DB_HOST=
SOURCE_DB_PORT=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=    # ← 同样绝不写进 git
SOURCE_DB_NAME=

# -----------------------------------------------------------------------------
# HTTP API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8100
APP_DEBUG=false        # 生产保持 false

# -----------------------------------------------------------------------------
# Worker / 队列
# EMBED_BATCH_SIZE：本地 bge-m3 可 32；阿里云 compatible-mode 单批 input 上限 10。
# -----------------------------------------------------------------------------
EMBED_BATCH_SIZE=32
EMBED_WORKER_BATCH_DOCS=8
EMBED_WORKER_POLL_SECONDS=1
EMBED_WORKER_STALE_SECONDS=3600
EMBED_WORKER_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# PDF 扫描页 OCR（仅当库 ocr_enabled 开启时生效；需 pip install -e ".[ocr]"）
# 文字版 PDF 不受影响；图片页才渲染 + OCR。
# -----------------------------------------------------------------------------
PDF_OCR_MIN_TEXT_CHARS=20
PDF_OCR_RENDER_DPI=200
PDF_OCR_MAX_PAGES=50

# -----------------------------------------------------------------------------
# 默认切分参数（库级可覆盖）
# -----------------------------------------------------------------------------
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=120

# -----------------------------------------------------------------------------
# Authentication
# JWT_SECRET 生产必改：openssl rand -hex 32。多 API 副本间必须一致。
# 上 HTTPS 时 COOKIE_SECURE=true。
# -----------------------------------------------------------------------------
JWT_SECRET=             # ← openssl rand -hex 32 生成，绝不用默认值/不写进 git
COOKIE_SECURE=false
ALLOW_PUBLIC_REGISTRATION=false
ORGANIZATION_AUTHORIZATION_ENABLED=false

# -----------------------------------------------------------------------------
# v0.4 Graph Extraction Pipeline (M1 foundation; default fail closed)
# GRAPH_EXTRACTION_API_KEY never falls back to CHAT_API_KEY. Never commit a key.
# M1 provides schema/config/heartbeat only; extraction runtime arrives in later milestones.
# -----------------------------------------------------------------------------
GRAPH_EXTRACTION_ENABLED=false
GRAPH_EXTRACTION_AUTO_TRIGGER_ENABLED=false
GRAPH_EXTRACTION_BASE_URL=https://api.deepseek.com/v1
GRAPH_EXTRACTION_MODEL=deepseek-v4-pro
GRAPH_EXTRACTION_API_KEY=
GRAPH_EXTRACTION_TIMEOUT_SECONDS=120
GRAPH_EXTRACTION_TEMPERATURE=0
GRAPH_EXTRACTION_RESPONSE_FORMAT=json_object
GRAPH_EXTRACTION_MAX_CONTEXT_CHARS=24000
GRAPH_EXTRACTION_PREVIOUS_CHUNKS=1
GRAPH_EXTRACTION_NEXT_CHUNKS=1

GRAPH_EXTRACTION_PROMPT_VERSION=v1
GRAPH_EXTRACTION_EXTRACTOR_VERSION=v1
GRAPH_EXTRACTION_OUTPUT_PARSER_VERSION=v1
GRAPH_EXTRACTION_CONTEXT_POLICY_VERSION=v1
GRAPH_EXTRACTION_POLICY_VERSION=v1
GRAPH_EXTRACTION_NORMALIZATION_RULE_VERSION=normalization_v1
GRAPH_EXTRACTION_CONFIDENCE_POLICY_VERSION=v1

GRAPH_EXTRACTION_ENTITY_MATERIALIZATION_THRESHOLD=0.85
GRAPH_EXTRACTION_RELATION_DRAFT_THRESHOLD=0.85
GRAPH_EXTRACTION_WEIGHT_MODEL=0.25
GRAPH_EXTRACTION_WEIGHT_EVIDENCE=0.35
GRAPH_EXTRACTION_WEIGHT_SCHEMA=0.25
GRAPH_EXTRACTION_WEIGHT_NORMALIZATION=0.15
GRAPH_EXTRACTION_AUTO_EVIDENCE_TYPES=direct_statement,table_cell
GRAPH_EXTRACTION_EVIDENCE_GROUP_POLICY=all_claims_valid

GRAPH_EXTRACTION_WORKER_POLL_SECONDS=3
GRAPH_EXTRACTION_UNIT_LEASE_SECONDS=180
GRAPH_EXTRACTION_UNIT_LEASE_RENEW_SECONDS=30
GRAPH_EXTRACTION_WORKER_MAX_MODEL_ATTEMPTS=3

GRAPH_EXTRACTION_CONTEXT_RETENTION_DAYS=30
GRAPH_EXTRACTION_RAW_OUTPUT_RETENTION_DAYS=30
GRAPH_EXTRACTION_CANDIDATE_RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# v0.8 Knowledge Artifact Runtime (default fail closed)
# KNOWLEDGE_ARTIFACT_API_KEY is independent and must never be committed.
# -----------------------------------------------------------------------------
KNOWLEDGE_ARTIFACT_RUNTIME_ENABLED=false
KNOWLEDGE_ARTIFACT_AUTO_TRIGGER_ENABLED=false
KNOWLEDGE_ARTIFACT_EXTERNAL_MODEL_ENABLED=false
KNOWLEDGE_ARTIFACT_BASE_URL=https://api.deepseek.com/v1
KNOWLEDGE_ARTIFACT_MODEL=deepseek-v4-pro
KNOWLEDGE_ARTIFACT_API_KEY=
KNOWLEDGE_ARTIFACT_PROVIDER_TIMEOUT_SECONDS=120
KNOWLEDGE_ARTIFACT_SHORT_SUMMARY_MAX_CHARS=4000
KNOWLEDGE_ARTIFACT_MODEL_MAX_SOURCE_CHARS=24000
KNOWLEDGE_ARTIFACT_SUMMARY_EXTRACTOR_VERSION=summary-extractor-v1
KNOWLEDGE_ARTIFACT_OUTLINE_EXTRACTOR_VERSION=outline-extractor-v1
KNOWLEDGE_ARTIFACT_PROMPT_VERSION=summary-prompt-v1
KNOWLEDGE_ARTIFACT_WORKER_POLL_SECONDS=3
KNOWLEDGE_ARTIFACT_WORKER_LEASE_SECONDS=180
KNOWLEDGE_ARTIFACT_WORKER_RENEW_SECONDS=30
KNOWLEDGE_ARTIFACT_WORKER_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# v0.8 immutable DocumentRevision file storage (default fail closed)
# Local uses DOCUMENT_FILES_DIR. MinIO/OSS require pip install -e ".[object-storage]".
# Endpoint URLs and credentials are runtime-only and are never stored in file rows.
# -----------------------------------------------------------------------------
REVISION_FILE_STORAGE_ENABLED=false
DOCUMENT_FILES_DIR=storage/document_files
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ENDPOINT_REF=primary
DOCUMENT_STORAGE_ENDPOINT_URL=
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=
DOCUMENT_STORAGE_REGION=
DOCUMENT_STORAGE_MAX_READ_BYTES=52428800
DOCUMENT_STORAGE_SIGNED_URL_SECONDS=300

# v0.8 RevisionFile retention governance (default off; no physical deletion in foundation)
REVISION_RETENTION_ENABLED=false
REVISION_RETENTION_BATCH_SIZE=50
REVISION_RETENTION_IMPACT_EVIDENCE_SAMPLE=20

# -----------------------------------------------------------------------------
# v0.5 Active Graph Publication (M1 schema/config; default fail closed)
# M1 creates schema and validates config only; publication runtime arrives later.
# -----------------------------------------------------------------------------
GRAPH_PUBLICATION_ENABLED=false
GRAPH_PUBLICATION_REQUIRE_ENTITY_EVIDENCE=true
GRAPH_PUBLICATION_EXTRACTED_ENTITY_MIN_CONFIDENCE=0.85
GRAPH_PUBLICATION_EXTRACTED_RELATION_MIN_CONFIDENCE=0.85
GRAPH_PUBLICATION_MAX_ITEMS_PER_RUN=10000
GRAPH_PUBLICATION_POLICY_VERSION=v1
GRAPH_PUBLICATION_MANIFEST_VERSION=v1

# -----------------------------------------------------------------------------
# v0.6 Published Graph Retrieval (M1 contract only; default fail closed)
# M1 validates strict DTO/config bounds; no v0.6 route is mounted yet.
# -----------------------------------------------------------------------------
GRAPH_RETRIEVAL_ENABLED=false
GRAPH_RETRIEVAL_CONTRACT_VERSION=v1
GRAPH_RETRIEVAL_MAX_SEEDS=10
GRAPH_RETRIEVAL_MAX_HOPS=2
GRAPH_RETRIEVAL_MAX_NODES=100
GRAPH_RETRIEVAL_MAX_RELATIONS=200
GRAPH_RETRIEVAL_MAX_EVIDENCE_PER_FACT=20
GRAPH_RETRIEVAL_TIMEOUT_SECONDS=3.0

# -----------------------------------------------------------------------------
# v0.7 Publication-scoped Entity Linking (default fail closed)
# -----------------------------------------------------------------------------
ENTITY_LINKING_ENABLED=false
ENTITY_LINKING_CONTRACT_VERSION=v1
ENTITY_LINKING_POLICY_PATH=eval/entity_linking/link_policy_v11.json
ENTITY_LINKING_POLICY_SHA256=
ENTITY_LINKING_MAX_MENTIONS=10
ENTITY_LINKING_MAX_CANDIDATES=10
ENTITY_LINKING_MAX_PUBLICATION_ENTITIES=10000
ENTITY_LINKING_TIMEOUT_SECONDS=2.0
