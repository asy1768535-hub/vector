  "documents": [
    {"document_key": "overview", "text": "青岩光伏电站项目位于宁夏。华北电力设计院设计青岩光伏电站，远景能源供应逆变器A-01和逆变器A-02。王芳向周强汇报。"},
    {"document_key": "equipment", "text": "青岩光伏电站包含逆变器A-01、逆变器A-02、升压站、储能舱B-02、组件阵列C-03、集电线路L-01、气象站M-01和监控网关G-01。"},
    {"document_key": "operations", "text": "智能运维平台监控青岩光伏电站，运维班组负责运行该电站，调度中心调度青岩光伏电站。监控网关G-01连接智能运维平台。"},
    {"document_key": "governance", "text": "并网批复授权青岩光伏电站，2025年度运维计划适用于青岩光伏电站。设备检修工单WO-77维修逆变器A-01。"},
    {"document_key": "grid", "text": "组件阵列C-03属于青岩光伏电站，集电线路L-01连接组件阵列C-03和升压站，气象站M-01监测青岩光伏电站，逆变器A-01由远景能源供应。"}
  ],
