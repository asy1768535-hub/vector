{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "127.0.0.1", "--port", "8100"],
      "port": 8100
    },
    {
      "name": "preview-ui",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5599", "--directory", "admin-ui"],
      "port": 5599,
      "autoPort": false
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "dev"],
      "port": 9527,
      "autoPort": false
    }
  ]
}
