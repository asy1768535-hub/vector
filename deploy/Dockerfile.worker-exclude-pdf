# Worker-only overlay. The release script supplies the currently running
# worker image as BASE_IMAGE, so no unrelated application files are copied.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG WORKER
LABEL org.opencontainers.image.title="vector-knowledge" \
      org.opencontainers.image.release-id="20260920-exclude-pdf-workers" \
      org.opencontainers.image.description="Pause PDF import and embedding while consuming other formats"

USER root
COPY patch_worker_exclude_pdf.py /tmp/patch_worker_exclude_pdf.py
RUN python /tmp/patch_worker_exclude_pdf.py "${WORKER}" \
    && python -m compileall -q "/app/app/workers/${WORKER}.py" \
    && python -c "import app.workers.${WORKER}; print('PDF exclusion worker overlay: ok')"
USER 10001
