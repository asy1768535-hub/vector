# Keep the verified unified runtime and replace only the upload-completion
# service. This avoids shipping unrelated working-tree changes in a hotfix.
ARG BASE_IMAGE=vector-kb-app:unified-8a7ffcb-r3
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="vector-knowledge" \
      org.opencontainers.image.release-id="20260918-netdisk-preflight-persistence" \
      org.opencontainers.image.description="Persist verified uploads before Office signature rejection"

USER root
COPY --chown=10001:10001 import_uploads.py /app/app/services/import_uploads.py
RUN python -m compileall -q /app/app/services/import_uploads.py \
    && python -c "import app.services.import_uploads; print('upload completion import smoke: ok')"
USER 10001
